<nav class="{% if title == 'Home' %}nav-home{% else %}nav{% endif %}" aria-label="Primary">
  <ul class="nav__list">
    {% for item in site.nav %}
      {% if item.label != title %}
        <li class="nav__item"><a class="nav__link" href="{{ item.href }}">{{ item.label }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</nav>
